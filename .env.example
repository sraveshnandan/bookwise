# API Keys
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_google_books_api_key
EXPO_PUBLIC_API_URL=https://api.bookwise.app

# RevenueCat
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your_ios_revenuecat_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your_android_revenuecat_key

# Analytics
EXPO_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_key

# Sentry
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true